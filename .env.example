# Copy to .env and fill in. See README "API keys" for which experiments need what.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
XAI_API_KEY=xai-...

# Only needed for the original-paper configs (Gemini etc. via OpenRouter);
# not required for the coherence experiment itself.
OPENROUTER_API_KEY=sk-or-...

# Only if your network/antivirus intercepts TLS (corporate proxy, AV "HTTPS
# inspection"): point this at a PEM export of your OS trust store so the xAI
# gRPC channel trusts the injected certificates (gRPC ignores SSL_CERT_FILE).
# The httpx-based providers (Anthropic/OpenAI) use SSL_CERT_FILE instead.
# GRPC_DEFAULT_SSL_ROOTS_FILE_PATH=C:\path\to\os_roots.pem
# SSL_CERT_FILE=C:\path\to\os_roots.pem
